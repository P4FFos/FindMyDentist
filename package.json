{
    "name": "findmydentist",
    "version": "1.0.0",
    "scripts": {
        "appointmentsService": "node services/appointmentService/app.js",
        "timeslotsService": "node services/timeslotService/app.js",
        "notificationsService": "node services/notificationService/app.js",
        "dentist": "node services/dentistService/app.js",
        "patient": "node services/patientService/app.js",
        "client": "npm run dev --prefix client",
        "dev": "concurrently \"npm run appointmentsServizce\" \"npm run timeslotsService\" \"npm run notificationsService\" \"npm run dentist\" \"npm run patient\" \"npm run client\"",
        "start:testService": "npm run patient",
        "test": "cross-env NODE_ENV=test TEST_DATABASE_URL=mongodb://localhost:27017/FindMyDentistTestDB TEST_PORT=1883 concurrently \"npm run start:testService\" \"jest\"",
        "ci-test": "npm test"
    },
    "dependencies": {
        "@faker-js/faker": "^9.3.0",
        "concurrently": "^9.1.0",
        "cross-env": "^7.0.3",
        "dotenv": "^16.4.7",
        "findmydentist": "file:",
        "jest": "^29.7.0",
        "mongoose": "^8.9.0",
        "mqtt": "^5.10.3",
        "uuid": "^11.0.3"
    }
}
