							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Resource is CREATED\", function() {",
									"    pm.response.to.have.status(201);",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"patientID\", jsonData._id);",
									"    pm.expect(jsonData).to.have.property(\"_id\");",
									"});",
									"",
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Response contains patientID\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"_id\");",
									"});",
									"pm.test(\"Response contains firstName\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"firstName\", \"Bill\");",
									"});",
									"pm.test(\"Response contains secondName\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"secondName\", \"Who\");",
									"});",
									"pm.test(\"Response contains email\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"email\", \"email@gmail.com\");",
									"});",
									"pm.test(\"Response contains phone\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"phone\", \"+460777777777\");",
									"});",
									"pm.test(\"Response contains password\", function () {",
									"    var jsonData = pm.response.json(); ",
									"    pm.expect(jsonData).to.have.property(\"password\", \"password\");",
