{
    "name": "dentist",
    "version": "0.1.0",
    "engines": {
      "node": "20.x"
    },
    "scripts": {
      "start": "node ./app.js",
      "dev": "nodemon ./app.js",
      "test": "",
      "ci-test": "npm run newman-server",
      "newman-server": "cross-env-shell PORT=3000 \"run-p --race start newman-wait\"",
      "newman-wait": "wait-on http://localhost:3003/api && npm run newman",
      "newman": "newman run ../server/tests/server.postman_collection.json --env-var host=http://localhost:3003/api",
      "dropdb": "node ../server/tests/dropdb.js"
    },
    "dependencies": {
      "connect-history-api-fallback": "^2.0.0",
      "cors": "^2.8.5",
      "express": "^4.21.1",
      "method-override": "^3.0.0",
      "mongoose": "^8.8.1",
      "morgan": "^1.10.0",
      "mqtt": "^5.10.2",
      "nodemailer": "^6.9.16"
    },
    "devDependencies": {
      "cross-env": "^7.0.3",
      "newman": "^6.2.1",
      "nodemon": "^3.1.7",
      "npm-run-all": "^4.1.5",
      "wait-on": "^8.0.1"
    }
  }
